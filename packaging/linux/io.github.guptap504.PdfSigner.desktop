[Desktop Entry]
Type=Application
Name=PDF Signer
GenericName=PDF Form Filler
Comment=Fill in, sign, redact and watermark PDFs
Exec=pdf-signer %f
Icon=io.github.guptap504.PdfSigner
Terminal=false
Categories=Office;Graphics;Viewer;
MimeType=application/pdf;
Keywords=pdf;sign;signature;form;fill;redact;watermark;
StartupWMClass=io.github.guptap504.PdfSigner
